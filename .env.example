# PostgreSQL connection used by /api/interest and /api/companies.
# Local Docker example:
DATABASE_URL=postgresql://eu_calls:eu_calls_password@localhost:5432/eu_calls

# PostgreSQL schema used by the application. The app auto-creates it if missing.
DB_SCHEMA=eu_funding

# Set true only if your PostgreSQL server requires SSL.
DB_SSL=false

# Optional pool tuning for a self-hosted Node server.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Optional app port for npm start.
PORT=3000
